# AKO_Wall_Designer_Agent 环境变量配置

# LLM API Keys (至少配置一个即可)
OPENAI_API_KEY=sk-xxx
QWEN_API_KEY=sk-xxx
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 模型路径
MODEL_PATH=./models
OUTPUT_PATH=./outputs

# GPU 配置
CUDA_VISIBLE_DEVICES=0

# 日志级别
LOG_LEVEL=INFO

# 服务器配置
HOST=0.0.0.0
PORT=7860
